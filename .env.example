# Copy to .env for deployment tuning.
# F2LLM-v2-4B: multilingual instruction-aware embedding model for guided clustering.
LIS_EMBEDDING_MODEL=codefuse-ai/F2LLM-v2-4B
LIS_EMBEDDING_DIM=1024
LIS_EMBEDDING_BATCH_SIZE=32
LIS_EMBEDDING_DEVICE=auto
# auto selects bfloat16 on CUDA and float32 on CPU.
LIS_EMBEDDING_DTYPE=auto
LIS_EMBEDDING_INSTRUCTION=对临床诊断进行分类，生成适合聚类且有代表性的词向量
# Set to 1 after prewarming so runtime never reaches the network for model files.
LIS_MODEL_LOCAL_ONLY=1
# Rancher Desktop compose uses this host directory, outside the project tree.
LIS_MODEL_HOST_DIR=C:/LIS_Dashboard/models
LIS_MAX_UPLOAD_MB=1000
# For the one-time prewarm/download, set a token if your model mirror requires it.
# HF_TOKEN=
